package life:life@0.1.0;

world life {
  export tick: func();
  export %"inboxClear": func();
  export %"inboxPut": func(c: s32);
  export dispatch: func(id: s32);
  export cols: func() -> s32;
  export rows: func() -> s32;
  export cell: func() -> s32;
  export next: func(seed: s32) -> s32;
  export main: func();
}